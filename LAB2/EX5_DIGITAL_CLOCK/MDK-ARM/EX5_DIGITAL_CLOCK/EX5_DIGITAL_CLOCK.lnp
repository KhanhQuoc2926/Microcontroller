--cpu Cortex-M3
"ex5_digital_clock\startup_stm32f103xb.o"
"ex5_digital_clock\main.o"
"ex5_digital_clock\stm32f1xx_it.o"
"ex5_digital_clock\stm32f1xx_hal_msp.o"
"ex5_digital_clock\stm32f1xx_hal_gpio_ex.o"
"ex5_digital_clock\stm32f1xx_hal_tim.o"
"ex5_digital_clock\stm32f1xx_hal_tim_ex.o"
"ex5_digital_clock\stm32f1xx_hal.o"
"ex5_digital_clock\stm32f1xx_hal_rcc.o"
"ex5_digital_clock\stm32f1xx_hal_rcc_ex.o"
"ex5_digital_clock\stm32f1xx_hal_gpio.o"
"ex5_digital_clock\stm32f1xx_hal_dma.o"
"ex5_digital_clock\stm32f1xx_hal_cortex.o"
"ex5_digital_clock\stm32f1xx_hal_pwr.o"

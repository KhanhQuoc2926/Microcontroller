--cpu Cortex-M3
"ex10_real_clock\startup_stm32f103xb.o"
"ex10_real_clock\main.o"
"ex10_real_clock\stm32f1xx_it.o"
"ex10_real_clock\stm32f1xx_hal_msp.o"
"ex10_real_clock\stm32f1xx_hal_gpio_ex.o"
"ex10_real_clock\stm32f1xx_hal.o"
"ex10_real_clock\stm32f1xx_hal_rcc.o"
"ex10_real_clock\stm32f1xx_hal_rcc_ex.o"
"ex10_real_clock\stm32f1xx_hal_gpio.o"
"ex10_real_clock\stm32f1xx_hal_dma.o"
"ex10_real_clock\stm32f1xx_hal_cortex.o"
"ex10_real_clock\stm32f1xx_hal_pwr.o"
